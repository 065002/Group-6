# Copy this file to ".env" and replace every CHANGE_ME value.
#   CMD:        copy .env.example .env
#   PowerShell: Copy-Item .env.example .env
# ".env" is git-ignored. Never commit real passwords.
# Use letters and digits only for passwords (avoid  # $ " ' spaces).

# ---------- MySQL (Docker) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=logistics_streaming_project
MYSQL_USER=logistics_user
MYSQL_PASSWORD=CHANGE_ME_app_password
# Python on Windows connects here (container port 3306 is published on host 3307)
MYSQL_HOST=127.0.0.1
MYSQL_HOST_PORT=3307

# ---------- Grafana (Docker) ----------
# UI is always http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
GRAFANA_URL=http://localhost:3000

# ---------- Kafka (Docker, KRaft) ----------
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_EVENTS=logistics.delivery.events
KAFKA_TOPIC_CONTROL=logistics.pipeline.control
KAFKA_TOPIC_PARTITIONS=1
KAFKA_CONSUMER_GROUP=logistics-stream-processor
# Any base64-like 22-char id; only change it if you know why.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# ---------- Producer ----------
SOURCE_CSV=data/logistics_streaming_master.csv
# Milliseconds between records. 50 ms x 12,000 rows = about 10 minutes of live demo.
STREAM_INTERVAL_MS=50
# chronological = by order_date + order_time (recommended); file = original CSV row order
STREAM_ORDER=chronological
# false = one pass, publish every source row exactly once, then stop (default)
STREAM_LOOP=false
# Leave blank to auto-generate RUN-YYYYMMDD-HHMMSS
RUN_ID=

# ---------- Processor ----------
PROCESSOR_BATCH_SIZE=200
# true = processor exits after the whole batch is accounted for
PROCESSOR_EXIT_ON_COMPLETE=true

# ---------- Logging ----------
LOG_LEVEL=INFO
